-- Node Align hotkeys for the Nodes (Flow) view.
-- Copy this file into Fusion's Config folder and restart Fusion / Resolve.
-- Change the keys below if they clash with your own bindings.
{
	Hotkeys {
		Target = "FlowView",
		Defaults = true,

		ALT_A       = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Align_Auto.lua')) ]] }",
		ALT_H       = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Align_Horizontal.lua')) ]] }",
		ALT_V       = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Align_Vertical.lua')) ]] }",
		ALT_SHIFT_H = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Straighten_Row.lua')) ]] }",
		ALT_SHIFT_V = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Straighten_Column.lua')) ]] }",
		ALT_D       = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Distribute_Horizontal.lua')) ]] }",
		ALT_SHIFT_D = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Distribute_Vertical.lua')) ]] }",
		ALT_S       = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Spread.lua')) ]] }",
		ALT_SHIFT_S = "Execute{ cmd = [[ local c = comp or fu:GetCurrentComp(); c:RunScript(fu:MapPath('Scripts:Comp/NodeAlign/Tighten.lua')) ]] }",
	},
}
